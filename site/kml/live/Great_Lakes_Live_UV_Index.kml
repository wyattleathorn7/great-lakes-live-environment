          <refreshInterval>3600</refreshInterval>
        </Icon>
        <LatLonBox>
          <north>49.5</north>
          <south>40.5</south>
          <east>-73.5</east>
          <west>-93.0</west>
        </LatLonBox>
      </GroundOverlay>
