<?xml version="1.0" encoding="utf-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>🟩 LIVE OVATION AURORA FORECAST</name>
    <description><![CDATA[<p><b>Legend</b><br><img src="https://wyattleathorn7.github.io/great-lakes-live-environment/aurora_global/legend.png?v=ovation-global-2026-10-20T06-46-00Z-fcst-2026-10-20T08-12-00Z-r13-aurglobal-tx6" width="600" alt="legend"><br>Global OVATION auroral intensity, FIXED absolute scale 0&ndash;30+: <b>LOWEST 0</b> (transparent) &rarr; <b>6 bright green</b> (oval overhead) &rarr; <b>14 orange</b> &rarr; <b>23 magenta</b> (severe) &rarr; <b>HIGHEST+ 30+</b> (violet extreme). Same intensity always shows the same color. Isolated faint cells paint only where connected to genuinely active areas, so model background noise never renders as aurora.</p><p><b>Status:</b> LIVE / CURRENT FORECAST (OVATION Prime, hourly check)</p><p><b>Source:</b> NOAA/SWPC OVATION Prime aurora model (Aurora Viewline product family)<br/><a href="https://www.spaceweather.gov/products/aurora-viewline-tonight-and-tomorrow-night-experimental">https://www.spaceweather.gov/products/aurora-viewline-tonight-and-tomorrow-night-experimental</a></p><p>Transparent outside valid water data so existing project layers (shipwrecks, lighthouses, harbors, parks) stay visible. Turn on/off independently of all other layers.</p><p><i>Not endorsed by NOAA.</i></p>]]></description>
    <Folder>
      <name>LIVE GLOBAL OVATION AURORA FORECAST</name>
      <description><![CDATA[<p><img src="https://wyattleathorn7.github.io/great-lakes-live-environment/aurora_global/legend.png?v=ovation-global-2026-10-20T06-46-00Z-fcst-2026-10-20T08-12-00Z-r13-aurglobal-tx6" width="600" alt="key"></p><p>Global OVATION auroral intensity, FIXED absolute scale 0&ndash;30+: <b>LOWEST 0</b> (transparent) &rarr; <b>6 bright green</b> (oval overhead) &rarr; <b>14 orange</b> &rarr; <b>23 magenta</b> (severe) &rarr; <b>HIGHEST+ 30+</b> (violet extreme). Same intensity always shows the same color. Isolated faint cells paint only where connected to genuinely active areas, so model background noise never renders as aurora.</p>]]></description>
      <GroundOverlay>
        <name>🟩 LIVE OVATION AURORA FORECAST</name>
        <drawOrder>10</drawOrder>
        <Icon>
          <href>https://wyattleathorn7.github.io/great-lakes-live-environment/aurora_global/current.png?v=ovation-global-2026-10-20T06-46-00Z-fcst-2026-10-20T08-12-00Z-r13-aurglobal-tx6</href>
          <refreshMode>onInterval</refreshMode>
          <refreshInterval>3600</refreshInterval>
        </Icon>
        <LatLonBox>
          <north>90.0</north>
          <south>-90.0</south>
          <east>180.0</east>
          <west>-180.0</west>
        </LatLonBox>
      </GroundOverlay>
    </Folder>
  </Document>
</kml>
