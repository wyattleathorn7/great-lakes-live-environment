        <drawOrder>11</drawOrder>
        <Icon>
          <href>https://wyattleathorn7.github.io/great-lakes-live-environment/cloud_cover_na_continental/current.png?v=cloudIR-GOES-18-20261016T1430-GOES-19-20261016T1430-HIMAWARI-9-20261016T1400-METEOSAT-FES-20261016T1345-METEOSAT-IODC-20261016T1345-VIIRS-2026-10-16-2026-10-16-v6</href>
